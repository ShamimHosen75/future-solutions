# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://futuresolution.online

# ─── Supabase (Project Settings → API) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used for admin tasks & revalidation.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Cloudflare Turnstile (forms) ────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ─── Resend (transactional email) ────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="Future Solutions <hello@futuresolution.online>"
EMAIL_TO=hello@futuresolution.online

# ─── Google Maps embed (Contact page) ────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# ─── Security ────────────────────────────────────────────────────────────────
# Salt for hashing visitor IPs used in rate limiting (any random string).
IP_HASH_SALT=change-me
